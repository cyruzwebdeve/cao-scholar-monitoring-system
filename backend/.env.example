PORT=3601
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/scholar_monitoring?schema=public
# Use Prisma Postgres' direct URL here in production; locally this may match DATABASE_URL.
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/scholar_monitoring?schema=public
DATABASE_TARGET=local-v2
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail API mailer (recommended for Render Free because it works over HTTPS).
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional SMTP fallback for local development or a paid host that permits SMTP.
# Enable Google 2-Step Verification and use a 16-character App Password.
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=PGCEAP Community Affairs Office
APP_BASE_URL=http://localhost:5173

# Use separate Vercel Blob stores: private for scholar documents, public for announcements.
DOCUMENT_BLOB_READ_WRITE_TOKEN=
ANNOUNCEMENT_BLOB_READ_WRITE_TOKEN=

# Optional one-time production bootstrap. Remove each password after its first successful deploy.
BOOTSTRAP_ADMIN_NAME=PGCEAP Super Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

BOOTSTRAP_BILLING_ADMIN_NAME=Billing and Payroll Administrator
BOOTSTRAP_BILLING_ADMIN_EMAIL=
BOOTSTRAP_BILLING_ADMIN_PASSWORD=

BOOTSTRAP_MODERATOR_NAME=Content Moderator
BOOTSTRAP_MODERATOR_EMAIL=
BOOTSTRAP_MODERATOR_PASSWORD=
