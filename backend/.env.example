PORT=3601
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/scholar_monitoring?schema=public
# Use Prisma Postgres' direct URL here in production; locally this may match DATABASE_URL.
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/scholar_monitoring?schema=public
DATABASE_TARGET=local-v2
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use separate Vercel Blob stores: private for scholar documents, public for announcements.
DOCUMENT_BLOB_READ_WRITE_TOKEN=
ANNOUNCEMENT_BLOB_READ_WRITE_TOKEN=

# Optional one-time production bootstrap. Remove the password after the first successful deploy.
BOOTSTRAP_ADMIN_NAME=PGCEAP Super Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
